# data: demo always works; live uses AkShare/Eastmoney public endpoints
DATA_MODE=demo
TOP_N=50
TECHNOLOGY_RESERVE=10
MIN_AMOUNT=50000000
MIN_MARKET_CAP=2000000000
MAX_SECTORS=10

# Schedule uses Asia/Shanghai. The built-in scheduler runs while the web service is running.
SCHEDULE_ENABLED=true
SCHEDULE_HOUR=18
SCHEDULE_MINUTE=0
PUSH_ON_SCHEDULE=true
FACTOR_AUTO_UPDATE_ENABLED=true
FACTOR_UPDATE_DAY=1
FACTOR_UPDATE_HOUR=19
FACTOR_UPDATE_MINUTE=30
STRATEGY_PUSH_ENABLED=true
STRATEGY_TOP_N=5
STRATEGY_REBALANCE_DAYS=10
STRATEGY_MIN_HOLD_DAYS=5
STRATEGY_RANK_BUFFER=20
STRATEGY_SCORE_GAP=15
# contrarian keeps the enhanced factor strategy; lgbm_shadow records model picks without orders;
# lgbm_active writes adaptive orders only after a 126-session forward-paper gate.
STRATEGY_MODEL_BACKEND=contrarian
LGBM_MODEL_VERSION=lgbm_ranker_top5_v1
LGBM_UNIVERSE_MODE=dynamic
LGBM_HISTORY_DAYS=550
PAPER_INITIAL_CAPITAL=1000000
PAPER_COST_BPS=12
PAPER_LOT_SIZE=100
INDEPENDENT_SLEEVES_ENABLED=true
TREND_SLEEVE_WEIGHT=0.75
LGBM_SLEEVE_WEIGHT=0.25
TREND_HEDGE_RATIO=0.75
# Optional CSI300 futures-proxy overlay. Uses close/MA120 at T close and executes at T+1 open.
INDEX_HEDGE_ENABLED=false
INDEX_HEDGE_LOOKBACK=120
INDEX_HEDGE_THRESHOLD=1.0
INDEX_HEDGE_RATIO=0.50
INDEX_HEDGE_COST_BPS=2

# Optional OpenAI-compatible API. Without it, a deterministic research report is generated.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# Configure any combination of notification channels.
# WeCom receives the Markdown report plus a native PNG paper-equity curve.
FEISHU_WEBHOOK_URL=
WECOM_WEBHOOK_URL=
GENERIC_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
